# MongoDB Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/emi-secure?retryWrites=true&w=majority

# JWT Secret Key (MUST be at least 32 characters long)
# Generate a secure random string with this command:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHARACTER_SECRET_FROM_COMMAND_ABOVE

# Firebase Admin SDK Credentials
# OPTION 1: For local development - Path to your Firebase service account JSON file
# Download from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# OPTION 2: For production (e.g., Render, Heroku) - Entire JSON content as a string
# Copy the entire content of your firebase-service-account.json file here
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Server Port (optional, defaults to 3001)
PORT=3001

# =============================================================================
# 🔄 POST-RESET AUTO-PROVISIONING (for /api/public/apk-info endpoint)
# =============================================================================

# Public URL of your backend server (used to build APK download links)
# This becomes the APK download URL: ${BACKEND_URL}/EMI-Secure.apk
BACKEND_URL=https://emi-secure-system.onrender.com

# APK SHA-256 checksum (first 8 hex bytes = 4 bytes base64) for provisioning QR
# Generate after each build: certutil -hashfile EMI-Secure.apk SHA256
# Or update automatically via build_and_deploy.ps1
APK_SHA256_CHECKSUM=

# APK version string shown in /apk-info response
APK_VERSION=1.0
