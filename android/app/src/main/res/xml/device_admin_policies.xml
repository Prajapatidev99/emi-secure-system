<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- 🔒 Allows the admin app to remotely lock the device screen. -->
        <force-lock />
        <!-- 🔒 Allows the admin app itself to wipe device. -->
        <wipe-data />
        <!-- NOTE: User restrictions (DISALLOW_FACTORY_RESET, DISALLOW_SAFE_BOOT, etc.)
             are enforced programmatically via DevicePolicyManager in Kotlin code.
             They cannot be declared in this XML file. -->
    </uses-policies>
</device-admin>
