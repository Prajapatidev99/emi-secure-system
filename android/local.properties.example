# local.properties.example

## This file is an example of local.properties configuration
## Copy this file to local.properties and update with your values
## NEVER commit local.properties to version control!

# Android SDK location (auto-generated by Android Studio)
sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk

# Backend Configuration
# Replace with your actual backend URL
backend.url=https://emi-secure-system.onrender.com

# For development/testing, you can use:
# backend.url=http://localhost:3000
# backend.url=https://your-dev-server.com
